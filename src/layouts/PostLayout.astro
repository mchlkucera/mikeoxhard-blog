---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date?: Date;
  backLink?: { href: string; label: string };
  coverImage?: { src: string; alt: string };
  isItaly?: boolean;
}

const { title, date, backLink, coverImage, isItaly = false } = Astro.props;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout title={title}>
  <article class="post">
    {backLink && (
      <div class={`back-link-wrapper ${isItaly ? '' : 'post-back-link'}`}>
        <a href={backLink.href} class={isItaly ? 'italy-back-link' : ''}>
          {backLink.label}
        </a>
      </div>
    )}

    <header class="post-header">
      <h1>{title}</h1>
      {date && (
        <div class="post-meta">
          <time datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        </div>
      )}
    </header>

    {coverImage && (
      <figure class={isItaly ? '' : 'post-cover'}>
        <img
          src={coverImage.src}
          alt={coverImage.alt}
          class={isItaly ? 'italy-featured-image' : ''}
        />
        <figcaption>{coverImage.alt}</figcaption>
      </figure>
    )}

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>
