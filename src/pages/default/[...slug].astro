---
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const defaultArticles = await getCollection('default');

  return defaultArticles.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get title from frontmatter or filename
const title = entry.data.title || entry.id.replace(/\.md$/, '');

// Extract cover image from content
const extractCoverImage = (body: string) => {
  const imageMatch = body.match(/!\[([^\]]*)\]\(([^)]+)\)/);
  if (imageMatch) {
    return { alt: imageMatch[1], src: imageMatch[2] };
  }
  return null;
};

const coverImage = extractCoverImage(entry.body);
---

<PostLayout
  title={title}
  date={entry.data.date ? new Date(entry.data.date) : undefined}
  coverImage={coverImage}
  isItaly={false}
>
  <Content />
</PostLayout>

<style is:global>
  /* Hide the first image in default articles since we show it as cover */
  .post-content > p:first-child:has(img:only-child) {
    display: none;
  }
  .post-content > p:first-child > img:only-child {
    display: none;
  }
</style>
