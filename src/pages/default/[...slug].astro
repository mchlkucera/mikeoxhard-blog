---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const defaultArticles = await getCollection('default');

  return defaultArticles.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '').toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const title = entry.data.title || entry.id.replace(/\.md$/, '');

const extractCoverImage = (body: string): { alt: string; src: string } | undefined => {
  const imageMatch = body.match(/!\[([^\]]*)\]\(([^)]+)\)/);
  if (imageMatch) {
    return { alt: imageMatch[1], src: imageMatch[2] };
  }
  return undefined;
};

const coverImage = extractCoverImage(entry.body);
---

<PostLayout
  title={title}
  date={entry.data.date ? new Date(entry.data.date) : undefined}
  layer={entry.data.layer}
  backLink={{ href: '/', label: '\u2190 Back' }}
  coverImage={coverImage}
>
  <Content />
</PostLayout>

<style is:global>
  .post-content > p:first-child:has(img:only-child) {
    display: none;
  }
  .post-content > p:first-child > img:only-child {
    display: none;
  }
</style>
