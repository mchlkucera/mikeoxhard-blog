---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const italyArticles = await getCollection('italy', ({ id }) => id !== 'index.md');

  return italyArticles.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '').toLowerCase().replace(/\s+/g, '-');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get title from filename
const title = entry.id.replace(/\.md$/, '');

// Extract cover image from content
const extractCoverImage = (body: string): { alt: string; src: string } | undefined => {
  const imageMatch = body.match(/!\[([^\]]*)\]\(([^)]+)\)/);
  if (imageMatch) {
    return { alt: imageMatch[1], src: imageMatch[2] };
  }
  return undefined;
};

const coverImage = extractCoverImage(entry.body);
---

<PostLayout
  title={title}
  date={entry.data.date ? new Date(entry.data.date) : undefined}
  backLink={{ href: '/italy/', label: '\u2190 Back' }}
  coverImage={coverImage}
>
  <Content />
</PostLayout>

<style is:global>
  /* Hide the first image in articles since we show it as cover */
  .post-content > p:first-child:has(img:only-child) {
    display: none;
  }
  .post-content > p:first-child > img:only-child {
    display: none;
  }
</style>
